# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/guides/precise-prefix-cache-aware.yaml

# [OPTIONAL] Experiment definitions
experiments:
  - name: "precise-prefix-cache-aware"
    attributes:
      - name: "setup"
        constants:
          - model.maxModelLen: 12000
          - model.blockSize: 64
        factors:
          - name: inferenceExtension.pluginsConfigFile
            levels:
              - default
              - prefix-cache-estimate-config
              - prefix-cache-tracking-config
        treatments:
          - "default"
          - "prefix-cache-estimate-config"
          - "prefix-cache-tracking-config"
      - name: "run"
        constants:
          - streaming: true
        factors:
          - name: num_groups
            levels: [40, 60]
          - name: system_prompt_len
            levels: [80000, 5000, 1000]
        treatments:
          - "40,8000"
          - "60,5000"
          - "60,1000"
